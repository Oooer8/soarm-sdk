<?xml version="1.0"?>
<robot name="soarm">
  <material name="soarm_dark">
    <color rgba="0.08 0.10 0.12 1.0"/>
  </material>
  <material name="soarm_blue">
    <color rgba="0.10 0.50 1.00 1.0"/>
  </material>
  <material name="soarm_link">
    <color rgba="0.72 0.76 0.82 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.070" length="0.070"/>
      </geometry>
      <material name="soarm_dark"/>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="1.5"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.120"/>
      </geometry>
      <material name="soarm_blue"/>
    </visual>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9" upper="1.9" effort="1" velocity="1.2"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.080 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.160"/>
      </geometry>
      <material name="soarm_link"/>
    </visual>
  </link>

  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.160 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7" upper="1.7" effort="1" velocity="1.5"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.080 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.160"/>
      </geometry>
      <material name="soarm_link"/>
    </visual>
  </link>

  <joint name="wrist_flex" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.160 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7" upper="1.7" effort="1" velocity="1.8"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.0375 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.075"/>
      </geometry>
      <material name="soarm_blue"/>
    </visual>
  </link>

  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0.075 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="2.0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <origin xyz="0.0325 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.016" length="0.065"/>
      </geometry>
      <material name="soarm_dark"/>
    </visual>
  </link>

  <joint name="gripper" type="revolute">
    <parent link="tool_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.065 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="1" velocity="1.2"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0.025 0.018 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.010 0.018"/>
      </geometry>
      <material name="soarm_link"/>
    </visual>
    <visual>
      <origin xyz="0.025 -0.018 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.010 0.018"/>
      </geometry>
      <material name="soarm_link"/>
    </visual>
  </link>
</robot>
